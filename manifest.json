{
  "manifest_version": 3,
  "name": "HTML Canvas Recorder",
  "short_name": "Canvas Recorder",
  "version": "1.0.0",
  "description": "Record HTML5 canvas elements as video files with customizable settings. Perfect for capturing WebGL animations, 2D graphics, and interactive content.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "activeTab", "tabs", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.ts"
  },
  "action": {
    "default_title": "HTML Canvas Recorder",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Start or stop canvas recording"
    },
    "stop-recording": {
      "description": "Stop canvas recording"
    }
  },
  "author": {
    "email": "info@aokitsukasa.com"
  },
  "homepage_url": "https://github.com/atsekkei/html-canvas-recorder"
}
